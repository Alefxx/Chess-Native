{
  "expo": {
    "name": "chessnative",
    "slug": "chessnative",
    "version": "1.0.0",
    "orientation": "default",
    "scheme": "chessnative",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#07111f",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "softwareKeyboardLayoutMode": "resize",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "backgroundColor": "#07111f",
      "themeColor": "#07111f",
      "lang": "pt-BR"
    },
    "plugins": [
      "expo-status-bar",
      "expo-image",
      "expo-splash-screen"
    ]
  }
}
